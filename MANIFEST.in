include README.md README.zh-CN.md LICENSE CONTRIBUTING.md CONTRIBUTING_zh.md
include pyproject.toml setup.py
# The dashboard reads these files from the installed package, and the sdist is
# the supported source install as well as the input of the core wheel.
recursive-include rpent *.py *.toml *.html *.css *.js
recursive-include robots *.py *.toml *.md *.yaml *.yml *.json *.txt *.cpp *.html
recursive-include components *.py *.toml *.md *.yaml *.yml *.json *.txt
recursive-include tests *.py *.toml *.md *.json *.yaml *.txt *.sh
# The bootstrap launcher the installation guide tells a fresh checkout to run.
include rpent-install.sh
recursive-include docs *.rst *.md *.py *.txt *.yaml *.yml *.svg *.png *.css *.js
